{
  "name": "classive-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "javascript"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:generated": "node scripts/generate.mjs --check",
    "build": "npm run build --workspace=@classive/sdk",
    "test": "npm run check:generated && npm run build && node --test javascript/test/*.test.mjs",
    "pack:javascript": "npm pack --workspace=@classive/sdk"
  }
}
